// Cloudflare Workers config: serves the static files in ./site.
// _headers and _redirects inside ./site are applied automatically.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tiebreaker-psych",
  "compatibility_date": "2026-10-01",
  // Redirects tiebreakerpsych.com and the workers.dev address to www (see src/worker.js).
  "main": "./src/worker.js",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Required by `wrangler preview`, which Cloudflare runs for non-main branches.
  "previews": {}
}
